rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return (request.auth != null && request.auth.uid == userId) || 
             (userId is string && (userId.startsWith('FB_') || userId.startsWith('fb_')));
    }

    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email == "roybabli.mng1986@gmail.com" ||
        request.auth.token.email == "infinityfdilms466@gmail.com" ||
        request.auth.token.email == "infinityfilms466@gmail.com" ||
        request.auth.token.email == "hshshsjsjz@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true
        ))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // User profiles
    match /users/{userId} {
      allow list: if isSignedIn();
      allow get: if isSignedIn();
      
      allow create: if true; // Allow registration
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Transactions (subcollection)
    match /transactions/{userId}/items/{txId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update, delete: if isAdmin();
    }

    // Game History (subcollection)
    match /game_history/{userId}/items/{historyId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update, delete: if isAdmin();
    }

    // Global Game States (Managed by Server Engine)
    match /game_states/{gameId} {
      allow read, write: if true; // Allow server-side updates
    }

    // Live Overrides (Admin Controls)
    match /live_overrides/{docId} {
      allow read, write: if true; 
    }

    // Admin Control
    match /admin_control/{docId} {
      allow read, write: if true;
    }

    // Live Results (Managed by Server Engine)
    match /live_results/{gameId} {
      allow read, write: if true;
    }

    // Chat
    match /chat/{msgId} {
      allow read: if true;
      allow create: if request.auth != null || (msgId is string && msgId.startsWith('FB_'));
      allow update, delete: if isAdmin();
    }

    // Gift Codes
    match /gift_codes/{code} {
      allow read, write: if true;
      
      match /redemptions/{userId} {
        allow read, create: if isOwner(userId);
      }
    }

    // App Settings
    match /app_settings/{settingId} {
      allow read, write: if true;
    }

    // Settings (Managed by Server Engine)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Pending Transactions (Admin Panel)
    match /pending_transactions/{txId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Activation Codes
    match /activation_codes/{codeId} {
      allow list: if isAdmin();
      allow get: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Bet Collections (Used by Bet API / Server Engine)
    match /dragon_tiger_bets/{id} { allow read, create: if true; allow update, delete: if isAdmin(); }
    match /andar_bahar_bets/{id} { allow read, create: if true; allow update, delete: if isAdmin(); }
    match /jhandi_munda_bets/{id} { allow read, create: if true; allow update, delete: if isAdmin(); }
    match /cricket_bets/{id} { allow read, create: if true; allow update, delete: if isAdmin(); }
    match /cricket_hero_bets/{id} { allow read, create: if true; allow update, delete: if isAdmin(); }
    match /baccarat_bets/{id} { allow read, create: if true; allow update, delete: if isAdmin(); }
    match /roulette_bets/{id} { allow read, create: if true; allow update, delete: if isAdmin(); }
    match /sic_bo_bets/{id} { allow read, create: if true; allow update, delete: if isAdmin(); }
    match /color_prediction_bets/{id} { allow read, create: if true; allow update, delete: if isAdmin(); }
    match /vortex_bets/{id} { allow read, create: if true; allow update, delete: if isAdmin(); }
    match /seven_up_down_bets/{id} { allow read, create: if true; allow update, delete: if isAdmin(); }
    match /hilo_bets/{id} { allow read, create: if true; allow update, delete: if isAdmin(); }
    match /keno_bets/{id} { allow read, create: if true; allow update, delete: if isAdmin(); }
    match /limbo_bets/{id} { allow read, create: if true; allow update, delete: if isAdmin(); }
    match /head_tails_bets/{id} { allow read, create: if true; allow update, delete: if isAdmin(); }

    // Test Connection
    match /test/connection {
      allow read: if true;
    }
  }
}
